-- Author: Simon Lartey
-- Project: CS232 Project 7 – Fibonacci Program
-- Description:
-- This program computes the Fibonacci sequence iteratively.
-- It repeatedly adds two registers and shifts values to
-- generate the next number in the sequence.

DEPTH = 256;
WIDTH = 16;
ADDRESS_RADIX = HEX;
DATA_RADIX = BIN;

CONTENT
BEGIN

-- Initialization
00 : 1111100000000000;  -- MOVE 0 → RA   (initialize previous value: a = 0)
01 : 1111100000001001;  -- MOVE 1 → RB   (initialize current value: b = 1)
02 : 1111100001000011;  -- MOVE 1 → RC   (temporary register for next value)
03 : 1111100000001100;  -- MOVE 0 → RD   (unused / temp register)

-- Fibonacci computation loop
04 : 1000000001000010;  -- ADD RA + RB → RC   (compute next = a + b)

-- Shift values for next iteration
05 : 1111000100000000;  -- MOVE RB → RA   (update previous value: a = b)
06 : 1111001000000001;  -- MOVE RC → RB   (update current value: b = next)

-- Additional ALU / control step
07 : 1001011100000011;  -- ALU operation (used for internal state / loop support)

-- Loop control
08 : 0011000000001010;  -- CBRANCH → 0A   (exit loop if condition met)
09 : 0010000000000100;  -- JUMP → 04      (repeat loop)

-- Output result
0A : 0011110000000000;  -- OUTPUT RB      (final Fibonacci value)

-- Fill remaining memory
[0B..FF] : 1111111111111111;  -- HALT / unused memory

END;
