DEPTH = 256;
WIDTH = 16;
ADDRESS_RADIX = HEX;
DATA_RADIX = BIN;

CONTENT
BEGIN
00 : 1111100000100000;  -- MOVE 4 → RA
01 : 1111100000100001;  -- MOVE 4 → RB
02 : 1111100000001010; -- MOVE 1 → RC
03 : 1111100000000011; -- MOVE 0 → RD

04 : 1000000011000011; -- ADD RA+RD → RD
05 : 1001001010000001; -- SUB RB-RC → RB
06 : 0011000000001000; -- CBRANCH if ZERO → 08
07 : 0010000000000100; -- UBRANCH → 04

08 : 0110011000000000; -- OUTPUT RD
09 : 0011110000000000; -- HALT

[0A..FF] : 1111111111111111;
END;
