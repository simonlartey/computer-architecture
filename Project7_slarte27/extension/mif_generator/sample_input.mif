DEPTH = 256;
WIDTH = 16;
ADDRESS_RADIX = HEX;
DATA_RADIX = BIN;
CONTENT
BEGIN
00 : 1111100001000000; -- MOVE 8 → RA
01 : 1111100001000001; -- MOVE 8 → RB
02 : 1111100001000010; -- MOVE 8 → RC
03 : 1111100000001011; -- MOVE 1 → RD
04 : 1111100000010100; -- MOVE 2 → RE
05 : 1000011100000000; -- RA = RD + RE
06 : 1001011100000001; -- RB = RD - RE
07 : 0010000000000000; -- JUMP → 00
[08..FF] : 1111111111111111;
END
